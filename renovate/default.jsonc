{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Automerge inference-snaps-dev update PRs",
      "matchManagers": [
        "git-submodules"
      ],
      "matchDepNames": [
        "dev"
      ],
      "commitBody": "[skip ci]",
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update modelctl release and lint action ref",
      "managerFilePatterns": [
        "snap/snapcraft.yaml",
        ".github/workflows/pr-checks.yaml"
      ],
      "matchStrings": [
        "https://github\\.com/canonical/inference-snaps/releases/download/(?<currentValue>v[^/]+)/modelctl",
        "canonical/inference-snaps/\\.github/actions/lint-package@(?<currentValue>v[^\\s#]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "canonical/inference-snaps",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update inference-snaps-webui",
      "managerFilePatterns": [
        "snap/snapcraft.yaml"
      ],
      "matchStrings": [
        "https://github\\.com/canonical/inference-snaps-webui/releases/download/(?<currentValue>v[^/]+)/inference-snaps-webui"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "canonical/inference-snaps-webui",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update openvino-model-server",
      "managerFilePatterns": [
        "snap/snapcraft.yaml"
      ],
      // The version appears twice in the URL, e.g.
      //   .../download/v2026.3/ovms_ubuntu24_2026.3.0_python_off.tar.gz
      //                 ^tag        ^depType ^filename version
      // Tags may drop a trailing ".0" but filenames never do, so the URL is
      // rebuilt from newValue rather than substituting currentValue in place,
      // and `replace` pads X.Y to X.Y.0 for the filename version.
      // The OS (e.g. ubuntu24) is captured as depType because Renovate only
      // passes its own fields to templates, not custom named groups.
      "matchStrings": [
        "openvinotoolkit/model_server/releases/download/v(?<currentValue>[^/]+)/ovms_(?<depType>[^_]+)_[^_]+_"
      ],
      "autoReplaceStringTemplate": "openvinotoolkit/model_server/releases/download/v{{{newValue}}}/ovms_{{{depType}}}_{{{replace '^(\\d+\\.\\d+)$' '$1.0' newValue}}}_",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "openvinotoolkit/model_server",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update llama.cpp builds",
      "managerFilePatterns": [
        "snap/snapcraft.yaml"
      ],
      "matchStrings": [
        "https://github\\.com/canonical/llama\\.cpp-builds/releases/download/(?<currentValue>[^/]+)/llamacpp"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "canonical/llama.cpp-builds",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update intel-compute-runtime-bundle",
      "managerFilePatterns": [
        "snap/snapcraft.yaml"
      ],
      "matchStrings": [
        "source: https://github\\.com/canonical/intel-compute-runtime-bundle\\.git[ \\t]*\\r?\\n[ \\t]+source-tag: (?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "canonical/intel-compute-runtime-bundle",
      "versioningTemplate": "loose"
    }
  ]
}
